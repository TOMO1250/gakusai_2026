;メッセージエリアを非表示にする
@layopt layer=message0 visible=false

;右下のメニュー歯車を非表示にする
[hidemenubutton]

;テーマ一括返還プラグインを読み込む
[plugin name="theme_kopanda_bth_01"]
[clearfix name="role_button"]

;カスタムルビプラグインを読み込む
[plugin name="custom_ruby"]

;自動ルビプラグインを読み込む
[plugin name="auto_ruby"]

;タイトル画面にジャンプ
[jump storage="title.ks"]
